@inject DocsCredentialService CredentialService
@inject IJSRuntime JS

<div class="credentials-input d-flex align-items-center gap-2">
    <input id="credentialsClientId"
           type="password"
           placeholder="Client ID"
           @bind="_clientId"
           @bind:event="oninput"
           @onkeydown="OnKeyDown"
           class="form-control form-control-sm"
           style="max-width: 150px;" />
    <input id="credentialsClientSecret"
           type="password"
           placeholder="Client Secret"
           @bind="_clientSecret"
           @bind:event="oninput"
           @onkeydown="OnKeyDown"
           class="form-control form-control-sm"
           style="max-width: 150px;" />
    <button class="btn btn-sm btn-primary text-nowrap" @onclick="Apply"
            disabled="@(string.IsNullOrWhiteSpace(_clientId) || string.IsNullOrWhiteSpace(_clientSecret))">
        Apply
    </button>
    <span class="badge bg-secondary text-nowrap">Sandbox</span>
    @if (_applied)
    {
        <span class="badge bg-success">Active</span>
    }
</div>

@code {
    private string? _clientId;
    private string? _clientSecret;
    private bool _applied;

    protected override async Task OnAfterRenderAsync(bool firstRender)
    {
        if (firstRender)
        {
            try
            {
                var storedId = await JS.InvokeAsync<string?>("sessionStorage.getItem", "commerzbankClientId");
                var storedSecret = await JS.InvokeAsync<string?>("sessionStorage.getItem", "commerzbankClientSecret");
                if (!string.IsNullOrWhiteSpace(storedId) && !string.IsNullOrWhiteSpace(storedSecret))
                {
                    _clientId = storedId;
                    _clientSecret = storedSecret;
                    _applied = true;
                    CredentialService.UpdateCredentials(storedId, storedSecret);
                    StateHasChanged();
                }
            }
            catch (JSException) { /* sessionStorage unavailable, e.g. private browsing */ }
        }
    }

    private async Task OnKeyDown(KeyboardEventArgs e)
    {
        if (e.Key == "Enter" && !string.IsNullOrWhiteSpace(_clientId) && !string.IsNullOrWhiteSpace(_clientSecret))
            await Apply();
    }

    private async Task Apply()
    {
        if (string.IsNullOrWhiteSpace(_clientId) || string.IsNullOrWhiteSpace(_clientSecret)) return;

        await JS.InvokeVoidAsync("sessionStorage.setItem", "commerzbankClientId", _clientId);
        await JS.InvokeVoidAsync("sessionStorage.setItem", "commerzbankClientSecret", _clientSecret);
        CredentialService.UpdateCredentials(_clientId, _clientSecret);
        _applied = true;
    }
}
