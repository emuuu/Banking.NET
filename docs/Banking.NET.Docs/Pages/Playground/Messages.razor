@page "/playground/messages"
@inject CorporatePaymentsClientFactory ClientFactory
@inject DocsCredentialService CredentialService

<PageTitle>Messages - Banking.NET Docs</PageTitle>

<div class="doc-content">
    <h1>Messages</h1>
    <p class="lead text-muted">Lists messages waiting to be downloaded from the sandbox mailbox, optionally filtered by order type.</p>

    <CredentialsWarning />

    <div class="try-it-panel">
        <div class="panel-header">List messages</div>
        <div class="panel-body">
            <div class="row g-2 align-items-end">
                <div class="col-auto">
                    <label class="form-label small mb-1" for="orderTypeFilter">Order type filter (optional)</label>
                    <input id="orderTypeFilter" class="form-control form-control-sm" style="max-width:160px;" placeholder="e.g. C53"
                           @bind="_orderTypeFilter" @bind:event="oninput" />
                </div>
                <div class="col-auto">
                    <button class="btn btn-primary" @onclick="LoadAsync" disabled="@(!CredentialService.HasCredentials || _loading)">
                        @if (_loading)
                        {
                            <span class="spinner-border spinner-border-sm me-1" role="status"></span>
                        }
                        List
                    </button>
                </div>
            </div>

            @if (!CredentialService.HasCredentials)
            {
                <div class="text-muted small mt-2">Enter a sandbox Client ID and Client Secret in the header to enable execution.</div>
            }

            @if (_error is not null)
            {
                <div class="alert alert-danger mt-3 mb-0" role="alert"><strong>Error:</strong> @_error</div>
            }

            @if (_messages is not null)
            {
                @if (_messages.Count == 0)
                {
                    <p class="text-muted mt-3 mb-0">No messages waiting.</p>
                }
                else
                {
                    <div class="table-responsive mt-3">
                        <table class="table table-sm table-hover align-middle">
                            <thead>
                                <tr>
                                    <th scope="col">Message ID</th>
                                    <th scope="col">Order Type</th>
                                    <th scope="col">Fragments</th>
                                    <th scope="col">Size</th>
                                    <th scope="col"></th>
                                </tr>
                            </thead>
                            <tbody>
                                @foreach (var message in _messages)
                                {
                                    <tr>
                                        <td><code>@message.MessageId</code></td>
                                        <td><code>@message.OrderType.Code</code></td>
                                        <td>@message.Fragments</td>
                                        <td>@FormatSize(message.Size)</td>
                                        <td><a href="@DownloadHref(message.MessageId)" class="btn btn-sm btn-outline-primary">Download &rarr;</a></td>
                                    </tr>
                                }
                            </tbody>
                        </table>
                    </div>
                }
            }
        </div>
    </div>
</div>

@code {
    private string _orderTypeFilter = "";
    private bool _loading;
    private string? _error;
    private IReadOnlyList<MessageInfo>? _messages;

    private async Task LoadAsync()
    {
        var client = ClientFactory.Client;
        if (client is null) return;

        _loading = true;
        _error = null;
        StateHasChanged();

        try
        {
            OrderType? orderType = string.IsNullOrWhiteSpace(_orderTypeFilter) ? null : OrderType.Parse(_orderTypeFilter);
            _messages = await client.ListMessagesAsync(orderType);
        }
        catch (Exception ex)
        {
            _error = ex.Message;
            _messages = null;
        }
        finally
        {
            _loading = false;
            StateHasChanged();
        }
    }

    private static string FormatSize(long bytes)
    {
        if (bytes < 1024) return $"{bytes} B";
        if (bytes < 1024 * 1024) return $"{bytes / 1024.0:F1} KB";
        return $"{bytes / (1024.0 * 1024.0):F1} MB";
    }

    private static string DownloadHref(string messageId) => $"playground/download?messageId={Uri.EscapeDataString(messageId)}";
}
