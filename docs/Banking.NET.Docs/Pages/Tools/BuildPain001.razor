@page "/tools/build-pain001"

<PageTitle>Build pain.001 - Banking.NET Docs</PageTitle>

<div class="doc-content">
    <h1>Build pain.001</h1>
    <p class="lead text-muted">
        Fill in a single payment information batch with a single credit transfer transaction and build the
        corresponding pain.001 (<code>CreditTransferInitiation</code>) document entirely offline using
        <code>Pain001Writer</code>. No network connection is made and nothing leaves your browser.
    </p>

    <div class="try-it-panel">
        <div class="panel-header">Build document</div>
        <div class="panel-body">
            <h6>Message</h6>
            <div class="row g-2 mb-3">
                <div class="col-md-4">
                    <label class="form-label small mb-1" for="p001MessageId">Message ID</label>
                    <input id="p001MessageId" class="form-control form-control-sm" @bind="_messageId" />
                </div>
                <div class="col-md-4">
                    <label class="form-label small mb-1" for="p001InitiatingParty">Initiating party name</label>
                    <input id="p001InitiatingParty" class="form-control form-control-sm" @bind="_initiatingPartyName" />
                </div>
                <div class="col-md-4">
                    <label class="form-label small mb-1" for="p001Version">Version</label>
                    <select id="p001Version" class="form-select form-select-sm" @bind="_version">
                        <option value="@Pain001Version.V03">V03 (pain.001.001.03)</option>
                        <option value="@Pain001Version.V09">V09 (pain.001.001.09)</option>
                    </select>
                </div>
            </div>

            <h6>Payment information</h6>
            <div class="row g-2 mb-3">
                <div class="col-md-4">
                    <label class="form-label small mb-1" for="p001PaymentInformationId">Payment information ID</label>
                    <input id="p001PaymentInformationId" class="form-control form-control-sm" @bind="_paymentInformationId" />
                </div>
                <div class="col-md-4">
                    <label class="form-label small mb-1" for="p001ExecutionDate">Requested execution date</label>
                    <input id="p001ExecutionDate" type="date" class="form-control form-control-sm" @bind="_requestedExecutionDate" />
                </div>
            </div>

            <h6>Debtor</h6>
            <div class="row g-2 mb-3">
                <div class="col-md-4">
                    <label class="form-label small mb-1" for="p001DebtorName">Debtor name</label>
                    <input id="p001DebtorName" class="form-control form-control-sm" @bind="_debtorName" />
                </div>
                <div class="col-md-4">
                    <label class="form-label small mb-1" for="p001DebtorIban">Debtor IBAN</label>
                    <input id="p001DebtorIban" class="form-control form-control-sm font-monospace" @bind="_debtorIban" />
                </div>
                <div class="col-md-4">
                    <label class="form-label small mb-1" for="p001DebtorBic">Debtor BIC</label>
                    <input id="p001DebtorBic" class="form-control form-control-sm font-monospace" @bind="_debtorBic" />
                </div>
            </div>

            <h6>Transaction</h6>
            <div class="row g-2 mb-3">
                <div class="col-md-4">
                    <label class="form-label small mb-1" for="p001EndToEndId">End-to-end ID</label>
                    <input id="p001EndToEndId" class="form-control form-control-sm" @bind="_endToEndId" />
                </div>
                <div class="col-md-2">
                    <label class="form-label small mb-1" for="p001Amount">Amount</label>
                    <input id="p001Amount" type="number" step="0.01" class="form-control form-control-sm" @bind="_amount" />
                </div>
                <div class="col-md-2">
                    <label class="form-label small mb-1" for="p001Currency">Currency</label>
                    <input id="p001Currency" class="form-control form-control-sm" @bind="_currency" />
                </div>
            </div>

            <h6>Creditor</h6>
            <div class="row g-2 mb-3">
                <div class="col-md-4">
                    <label class="form-label small mb-1" for="p001CreditorName">Creditor name</label>
                    <input id="p001CreditorName" class="form-control form-control-sm" @bind="_creditorName" />
                </div>
                <div class="col-md-4">
                    <label class="form-label small mb-1" for="p001CreditorIban">Creditor IBAN</label>
                    <input id="p001CreditorIban" class="form-control form-control-sm font-monospace" @bind="_creditorIban" />
                </div>
                <div class="col-md-4">
                    <label class="form-label small mb-1" for="p001CreditorBic">Creditor BIC</label>
                    <input id="p001CreditorBic" class="form-control form-control-sm font-monospace" @bind="_creditorBic" />
                </div>
            </div>

            <div class="row g-2 mb-3">
                <div class="col-md-8">
                    <label class="form-label small mb-1" for="p001Remittance">Unstructured remittance information</label>
                    <input id="p001Remittance" class="form-control form-control-sm" @bind="_remittanceInformation" />
                </div>
            </div>

            <div class="d-flex gap-2">
                <button class="btn btn-primary" @onclick="Build">Build pain.001</button>
                @if (_error is not null || _xml is not null)
                {
                    <button class="btn btn-outline-secondary" @onclick="Clear">Clear</button>
                }
            </div>

            @if (_error is not null)
            {
                <div class="alert alert-danger mt-3 mb-0" role="alert"><strong>Error:</strong> @_error</div>
            }

            @if (_xml is not null)
            {
                <div class="mt-3">
                    <CodeBlock Language="xml" Code="@_xml" MaxHeight="400px" />
                </div>
            }
        </div>
    </div>
</div>

@code {
    private string _messageId = "SAMPLE-MSG-0001";
    private string _initiatingPartyName = "Example Debtor GmbH";
    private Pain001Version _version = Pain001Version.V09;

    private string _paymentInformationId = "SAMPLE-PMTINF-0001";
    private DateOnly _requestedExecutionDate = DateOnly.FromDateTime(DateTime.UtcNow.AddDays(1));

    private string _debtorName = "Example Debtor GmbH";
    private string _debtorIban = "DE89370400440532013000";
    private string _debtorBic = "COBADEFFXXX";

    private string _endToEndId = "SAMPLE-E2E-0001";
    private decimal _amount = 100.00m;
    private string _currency = "EUR";

    private string _creditorName = "Example Creditor Ltd";
    private string _creditorIban = "DE02120300000000202051";
    private string _creditorBic = "MARKDEF1100";

    private string _remittanceInformation = "Sample payment";

    private string? _xml;
    private string? _error;

    private void Build()
    {
        _error = null;
        _xml = null;

        try
        {
            var initiation = new CreditTransferInitiation
            {
                MessageId = _messageId,
                InitiatingParty = new PartyIdentification { Name = _initiatingPartyName },
                PaymentInformations =
                [
                    new CreditTransferPaymentInformation
                    {
                        PaymentInformationId = _paymentInformationId,
                        RequestedExecutionDate = _requestedExecutionDate,
                        Debtor = new PartyIdentification { Name = _debtorName },
                        DebtorAccount = new AccountIdentification { Iban = _debtorIban },
                        DebtorAgent = new FinancialInstitution { Bic = _debtorBic },
                        Transactions =
                        [
                            new CreditTransferTransaction
                            {
                                EndToEndId = _endToEndId,
                                Amount = new Money(_amount, _currency),
                                Creditor = new PartyIdentification { Name = _creditorName },
                                CreditorAccount = new AccountIdentification { Iban = _creditorIban },
                                CreditorAgent = new FinancialInstitution { Bic = _creditorBic },
                                RemittanceInformation = string.IsNullOrWhiteSpace(_remittanceInformation)
                                    ? null
                                    : new RemittanceInformation { Unstructured = [_remittanceInformation] }
                            }
                        ]
                    }
                ]
            };

            _xml = Pain001Writer.WriteToString(initiation, _version);
        }
        catch (Iso20022ValidationException ex)
        {
            _error = ex.Path is null ? ex.Message : $"{ex.Message} (Path: {ex.Path})";
        }
    }

    private void Clear()
    {
        _error = null;
        _xml = null;
    }
}
