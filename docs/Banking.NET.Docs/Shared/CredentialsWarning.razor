@inject DocsCredentialService CredentialService
@implements IDisposable

@if (!CredentialService.HasCredentials)
{
    <div class="alert alert-warning d-flex align-items-center" role="alert">
        <strong class="me-2">No sandbox credentials configured.</strong>
        <span>Enter a Client ID and Client Secret in the header to enable this playground page.</span>
    </div>
}

<div class="alert alert-info small mt-2" role="alert">
    Credentials stay in your browser; the playground talks to the Commerzbank sandbox only.
    Production requires a client certificate and cannot be used here.
</div>

@code {
    protected override void OnInitialized() => CredentialService.CredentialsChanged += OnCredentialsChanged;
    private void OnCredentialsChanged() => InvokeAsync(StateHasChanged);
    public void Dispose() => CredentialService.CredentialsChanged -= OnCredentialsChanged;
}
