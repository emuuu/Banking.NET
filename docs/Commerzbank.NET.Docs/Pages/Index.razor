@page "/"

<PageTitle>Commerzbank.NET Docs</PageTitle>

<div class="landing-page py-5">
    <div class="text-center mb-5">
        <img src="img/logo.svg" alt="Commerzbank.NET" width="96" height="96" class="mb-3 landing-hero-logo" />
        <h1 class="display-4 fw-bold">Commerzbank.NET</h1>
        <p class="lead text-muted">
            An unofficial, strongly-typed .NET client for the Commerzbank Corporate Payments API.
            Download and submit EBICS-based messages, and read and write ISO 20022 camt and pain documents, with full async support.
        </p>
        <div class="mt-4">
            <a href="docs/getting-started/installation" class="btn btn-primary btn-lg me-2">Get Started</a>
            <a href="api" class="btn btn-outline-primary btn-lg me-2">API Reference</a>
            <a href="playground/heartbeat" class="btn btn-outline-primary btn-lg me-2">Playground</a>
            <a href="https://github.com/emuuu/Commerzbank.NET" class="btn btn-outline-secondary btn-lg"
               target="_blank" rel="noopener">GitHub</a>
        </div>
    </div>

    <div class="row g-4 mt-4">
        <div class="col-md-4">
            <div class="card h-100">
                <div class="card-body">
                    <h5 class="card-title">Getting Started</h5>
                    <p class="card-text text-muted">Install the NuGet package, configure sandbox or production, and make your first call.</p>
                    <a href="docs/getting-started/installation" class="btn btn-sm btn-outline-primary">Get Started</a>
                </div>
            </div>
        </div>
        <div class="col-md-4">
            <div class="card h-100">
                <div class="card-body">
                    <h5 class="card-title">API Reference</h5>
                    <p class="card-text text-muted">Browse the Corporate Payments client, authentication, exceptions, and ISO 20022 types, generated from XML docs.</p>
                    <a href="api" class="btn btn-sm btn-outline-primary">Browse API</a>
                </div>
            </div>
        </div>
        <div class="col-md-4">
            <div class="card h-100">
                <div class="card-body">
                    <h5 class="card-title">Playground</h5>
                    <p class="card-text text-muted">Try Heartbeat, message listing, download, confirm, and order submission against the Commerzbank sandbox.</p>
                    <a href="playground/heartbeat" class="btn btn-sm btn-outline-primary">Open Playground</a>
                </div>
            </div>
        </div>
    </div>

    <div class="mt-5">
        <h4 class="mb-3">Quick Example</h4>
        <CodeBlock Language="csharp" Code="@ProgramCs" />
        <div class="mt-3">
            <CodeBlock Language="csharp" Code="@UsageExample" MaxHeight="320px" />
        </div>
    </div>
</div>

@code {
    private const string ProgramCs = """
        builder.Services.AddCommerzbank(options =>
        {
            options.ClientId = "your-client-id";
            options.ClientSecret = "your-client-secret";
            options.Environment = CommerzbankEnvironment.Sandbox;
        }).AddCorporatePayments();
        """;

    private const string UsageExample = """
        public class MessageService
        {
            private readonly ICorporatePaymentsClient _client;

            public MessageService(ICorporatePaymentsClient client)
            {
                _client = client;
            }

            public async Task ListWaitingMessagesAsync()
            {
                var messages = await _client.ListMessagesAsync(OrderType.C53);
                foreach (var message in messages)
                {
                    Console.WriteLine($"{message.MessageId}: {message.Fragments} fragment(s), {message.Size} bytes");
                }
            }
        }
        """;
}
