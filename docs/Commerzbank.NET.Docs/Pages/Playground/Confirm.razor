@page "/playground/confirm"
@inject CorporatePaymentsClientFactory ClientFactory

<PageTitle>Confirm - Commerzbank.NET Docs</PageTitle>

<div class="doc-content">
    <h1>Confirm</h1>
    <p class="lead text-muted">Confirms receipt of a message so the bank stops redelivering it.</p>

    <div class="alert alert-warning" role="alert">
        <strong>Careful:</strong> confirming a message as <code>Complete</code> removes it from the sandbox mailbox — it
        will no longer appear on the <a href="playground/messages">Messages</a> page or be downloadable again.
    </div>

    <CredentialsWarning />

    <TryItPanel TResult="ConfirmResult" OnExecute="ExecuteAsync">
        <FormContent>
            <div class="row g-2">
                <div class="col-auto">
                    <label class="form-label small mb-1" for="confirmMessageId">Message ID</label>
                    <input id="confirmMessageId" class="form-control form-control-sm" style="max-width:280px;" @bind="_messageId" />
                </div>
                <div class="col-auto">
                    <label class="form-label small mb-1" for="confirmStatus">Status</label>
                    <select id="confirmStatus" class="form-select form-select-sm" @bind="_status">
                        <option value="@ReceivedStatus.Complete">Complete</option>
                        <option value="@ReceivedStatus.Partial">Partial</option>
                    </select>
                </div>
            </div>
        </FormContent>
    </TryItPanel>
</div>

@code {
    private string _messageId = "";
    private ReceivedStatus _status = ReceivedStatus.Complete;

    private async Task<ConfirmResult> ExecuteAsync()
    {
        if (string.IsNullOrWhiteSpace(_messageId))
            throw new ArgumentException("Enter a message ID first.");

        var client = ClientFactory.Client ?? throw new InvalidOperationException("Enter sandbox credentials first.");
        await client.ConfirmMessageAsync(_messageId.Trim(), _status);
        return new ConfirmResult(_messageId.Trim(), _status.ToString());
    }

    private sealed record ConfirmResult(string MessageId, string Status);
}
