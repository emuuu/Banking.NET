@page "/tools/build-pain008"

<PageTitle>Build pain.008 - Commerzbank.NET Docs</PageTitle>

<div class="doc-content">
    <h1>Build pain.008</h1>
    <p class="lead text-muted">
        Fill in a single payment information batch with a single direct debit transaction and build the
        corresponding pain.008 (<code>DirectDebitInitiation</code>) document entirely offline using
        <code>Pain008Writer</code>. No network connection is made and nothing leaves your browser.
    </p>

    <div class="try-it-panel">
        <div class="panel-header">Build document</div>
        <div class="panel-body">
            <h6>Message</h6>
            <div class="row g-2 mb-3">
                <div class="col-md-4">
                    <label class="form-label small mb-1" for="p008MessageId">Message ID</label>
                    <input id="p008MessageId" class="form-control form-control-sm" @bind="_messageId" />
                </div>
                <div class="col-md-4">
                    <label class="form-label small mb-1" for="p008InitiatingParty">Initiating party name</label>
                    <input id="p008InitiatingParty" class="form-control form-control-sm" @bind="_initiatingPartyName" />
                </div>
                <div class="col-md-4">
                    <label class="form-label small mb-1" for="p008Version">Version</label>
                    <select id="p008Version" class="form-select form-select-sm" @bind="_version">
                        <option value="@Pain008Version.V02">V02 (pain.008.001.02)</option>
                        <option value="@Pain008Version.V08">V08 (pain.008.001.08)</option>
                    </select>
                </div>
            </div>

            <h6>Payment information</h6>
            <div class="row g-2 mb-3">
                <div class="col-md-3">
                    <label class="form-label small mb-1" for="p008PaymentInformationId">Payment information ID</label>
                    <input id="p008PaymentInformationId" class="form-control form-control-sm" @bind="_paymentInformationId" />
                </div>
                <div class="col-md-3">
                    <label class="form-label small mb-1" for="p008Scheme">Scheme</label>
                    <select id="p008Scheme" class="form-select form-select-sm" @bind="_scheme">
                        <option value="@DirectDebitScheme.Core">Core</option>
                        <option value="@DirectDebitScheme.B2B">B2B</option>
                    </select>
                </div>
                <div class="col-md-3">
                    <label class="form-label small mb-1" for="p008SequenceType">Sequence type</label>
                    <select id="p008SequenceType" class="form-select form-select-sm" @bind="_sequenceType">
                        <option value="@SequenceType.First">First</option>
                        <option value="@SequenceType.Recurring">Recurring</option>
                        <option value="@SequenceType.OneOff">OneOff</option>
                        <option value="@SequenceType.Final">Final</option>
                    </select>
                </div>
                <div class="col-md-3">
                    <label class="form-label small mb-1" for="p008CollectionDate">Requested collection date</label>
                    <input id="p008CollectionDate" type="date" class="form-control form-control-sm" @bind="_requestedCollectionDate" />
                </div>
            </div>

            <h6>Creditor</h6>
            <div class="row g-2 mb-3">
                <div class="col-md-4">
                    <label class="form-label small mb-1" for="p008CreditorName">Creditor name</label>
                    <input id="p008CreditorName" class="form-control form-control-sm" @bind="_creditorName" />
                </div>
                <div class="col-md-4">
                    <label class="form-label small mb-1" for="p008CreditorIban">Creditor IBAN</label>
                    <input id="p008CreditorIban" class="form-control form-control-sm font-monospace" @bind="_creditorIban" />
                </div>
                <div class="col-md-4">
                    <label class="form-label small mb-1" for="p008CreditorBic">Creditor BIC</label>
                    <input id="p008CreditorBic" class="form-control form-control-sm font-monospace" @bind="_creditorBic" />
                </div>
            </div>
            <div class="row g-2 mb-3">
                <div class="col-md-6">
                    <label class="form-label small mb-1" for="p008CreditorSchemeId">Creditor scheme ID (SEPA creditor identifier)</label>
                    <input id="p008CreditorSchemeId" class="form-control form-control-sm font-monospace" @bind="_creditorSchemeId" />
                </div>
            </div>

            <h6>Transaction</h6>
            <div class="row g-2 mb-3">
                <div class="col-md-4">
                    <label class="form-label small mb-1" for="p008EndToEndId">End-to-end ID</label>
                    <input id="p008EndToEndId" class="form-control form-control-sm" @bind="_endToEndId" />
                </div>
                <div class="col-md-2">
                    <label class="form-label small mb-1" for="p008Amount">Amount</label>
                    <input id="p008Amount" type="number" step="0.01" class="form-control form-control-sm" @bind="_amount" />
                </div>
                <div class="col-md-2">
                    <label class="form-label small mb-1" for="p008Currency">Currency</label>
                    <input id="p008Currency" class="form-control form-control-sm" @bind="_currency" />
                </div>
            </div>
            <div class="row g-2 mb-3">
                <div class="col-md-4">
                    <label class="form-label small mb-1" for="p008MandateId">Mandate ID</label>
                    <input id="p008MandateId" class="form-control form-control-sm" @bind="_mandateId" />
                </div>
                <div class="col-md-4">
                    <label class="form-label small mb-1" for="p008DateOfSignature">Date of signature</label>
                    <input id="p008DateOfSignature" type="date" class="form-control form-control-sm" @bind="_dateOfSignature" />
                </div>
            </div>

            <h6>Debtor</h6>
            <div class="row g-2 mb-3">
                <div class="col-md-4">
                    <label class="form-label small mb-1" for="p008DebtorName">Debtor name</label>
                    <input id="p008DebtorName" class="form-control form-control-sm" @bind="_debtorName" />
                </div>
                <div class="col-md-4">
                    <label class="form-label small mb-1" for="p008DebtorIban">Debtor IBAN</label>
                    <input id="p008DebtorIban" class="form-control form-control-sm font-monospace" @bind="_debtorIban" />
                </div>
                <div class="col-md-4">
                    <label class="form-label small mb-1" for="p008DebtorBic">Debtor BIC</label>
                    <input id="p008DebtorBic" class="form-control form-control-sm font-monospace" @bind="_debtorBic" />
                </div>
            </div>

            <div class="row g-2 mb-3">
                <div class="col-md-8">
                    <label class="form-label small mb-1" for="p008Remittance">Unstructured remittance information</label>
                    <input id="p008Remittance" class="form-control form-control-sm" @bind="_remittanceInformation" />
                </div>
            </div>

            <div class="d-flex gap-2">
                <button class="btn btn-primary" @onclick="Build">Build pain.008</button>
                @if (_error is not null || _xml is not null)
                {
                    <button class="btn btn-outline-secondary" @onclick="Clear">Clear</button>
                }
            </div>

            @if (_error is not null)
            {
                <div class="alert alert-danger mt-3 mb-0" role="alert"><strong>Error:</strong> @_error</div>
            }

            @if (_xml is not null)
            {
                <div class="mt-3">
                    <CodeBlock Language="xml" Code="@_xml" MaxHeight="400px" />
                </div>
            }
        </div>
    </div>
</div>

@code {
    private string _messageId = "SAMPLE-MSG-0001";
    private string _initiatingPartyName = "Example Creditor Ltd";
    private Pain008Version _version = Pain008Version.V08;

    private string _paymentInformationId = "SAMPLE-PMTINF-0001";
    private DirectDebitScheme _scheme = DirectDebitScheme.Core;
    private SequenceType _sequenceType = SequenceType.Recurring;
    private DateOnly _requestedCollectionDate = DateOnly.FromDateTime(DateTime.UtcNow.AddDays(5));

    private string _creditorName = "Example Creditor Ltd";
    private string _creditorIban = "DE02120300000000202051";
    private string _creditorBic = "COBADEFFXXX";
    private string _creditorSchemeId = "DE98ZZZ09999999999";

    private string _endToEndId = "SAMPLE-E2E-0001";
    private decimal _amount = 100.00m;
    private string _currency = "EUR";

    private string _mandateId = "SAMPLE-MANDATE-0001";
    private DateOnly _dateOfSignature = DateOnly.FromDateTime(DateTime.UtcNow.AddYears(-1));

    private string _debtorName = "Example Debtor GmbH";
    private string _debtorIban = "DE89370400440532013000";
    private string _debtorBic = "MARKDEF1100";

    private string _remittanceInformation = "Sample collection";

    private string? _xml;
    private string? _error;

    private void Build()
    {
        _error = null;
        _xml = null;

        try
        {
            var initiation = new DirectDebitInitiation
            {
                MessageId = _messageId,
                InitiatingParty = new PartyIdentification { Name = _initiatingPartyName },
                PaymentInformations =
                [
                    new DirectDebitPaymentInformation
                    {
                        PaymentInformationId = _paymentInformationId,
                        Scheme = _scheme,
                        SequenceType = _sequenceType,
                        RequestedCollectionDate = _requestedCollectionDate,
                        Creditor = new PartyIdentification { Name = _creditorName },
                        CreditorAccount = new AccountIdentification { Iban = _creditorIban },
                        CreditorAgent = new FinancialInstitution { Bic = _creditorBic },
                        CreditorSchemeId = _creditorSchemeId,
                        Transactions =
                        [
                            new DirectDebitTransaction
                            {
                                EndToEndId = _endToEndId,
                                Amount = new Money(_amount, _currency),
                                Mandate = new MandateInformation
                                {
                                    MandateId = _mandateId,
                                    DateOfSignature = _dateOfSignature
                                },
                                Debtor = new PartyIdentification { Name = _debtorName },
                                DebtorAccount = new AccountIdentification { Iban = _debtorIban },
                                DebtorAgent = new FinancialInstitution { Bic = _debtorBic },
                                RemittanceInformation = string.IsNullOrWhiteSpace(_remittanceInformation)
                                    ? null
                                    : new RemittanceInformation { Unstructured = [_remittanceInformation] }
                            }
                        ]
                    }
                ]
            };

            _xml = Pain008Writer.WriteToString(initiation, _version);
        }
        catch (Iso20022ValidationException ex)
        {
            _error = ex.Path is null ? ex.Message : $"{ex.Message} (Path: {ex.Path})";
        }
    }

    private void Clear()
    {
        _error = null;
        _xml = null;
    }
}
