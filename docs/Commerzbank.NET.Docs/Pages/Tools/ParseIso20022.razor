@page "/tools/parse-iso20022"
@using System.Globalization
@using System.Xml.Linq

<PageTitle>Parse camt / pain.002 - Commerzbank.NET Docs</PageTitle>

<div class="doc-content">
    <h1>Parse camt / pain.002</h1>
    <p class="lead text-muted">
        Paste a camt.052/053/054, camt.086, or pain.002 document to parse it entirely offline, using
        <code>Iso20022Document</code>, <code>CamtReader</code>, <code>Camt086Reader</code>, and <code>Pain002Reader</code>.
        No network connection is made and nothing leaves your browser.
    </p>

    <div class="try-it-panel">
        <div class="panel-header">Parse document</div>
        <div class="panel-body">
            <textarea class="form-control font-monospace" style="min-height:220px;font-size:.8rem;" placeholder="Paste XML here..."
                      @bind="_xml" @bind:event="oninput"></textarea>
            <div class="d-flex gap-2 mt-3">
                <button class="btn btn-primary" @onclick="Parse" disabled="@string.IsNullOrWhiteSpace(_xml)">Parse</button>
                @if (_error is not null || _identifier is not null)
                {
                    <button class="btn btn-outline-secondary" @onclick="Clear">Clear</button>
                }
            </div>

            @if (_error is not null)
            {
                <div class="alert alert-danger mt-3 mb-0" role="alert"><strong>Error:</strong> @_error</div>
            }

            @if (_identifier is { } identifier)
            {
                <div class="table-responsive mt-3">
                    <table class="table table-sm">
                        <tbody>
                            <tr><th scope="row">Detected type</th><td><code>@identifier.Type</code></td></tr>
                            <tr><th scope="row">Schema identifier</th><td><code>@(string.IsNullOrEmpty(identifier.Identifier) ? "—" : identifier.Identifier)</code></td></tr>
                            <tr><th scope="row">Namespace</th><td><code>@identifier.Namespace</code></td></tr>
                        </tbody>
                    </table>
                </div>

                @if (_summaryRows is { Count: > 0 })
                {
                    <h6 class="mt-3">Summary</h6>
                    <div class="table-responsive">
                        <table class="table table-sm">
                            <tbody>
                                @foreach (var (label, value) in _summaryRows)
                                {
                                    <tr><th scope="row">@label</th><td>@value</td></tr>
                                }
                            </tbody>
                        </table>
                    </div>
                }

                @if (_camtEntries is { Count: > 0 })
                {
                    <h6 class="mt-3">Entries (first statement)</h6>
                    <div class="table-responsive">
                        <table class="table table-sm">
                            <thead>
                                <tr><th scope="col">Reference</th><th scope="col">Amount</th><th scope="col">Credit/Debit</th><th scope="col">Booking date</th></tr>
                            </thead>
                            <tbody>
                                @foreach (var entry in _camtEntries)
                                {
                                    <tr>
                                        <td><code>@entry.EntryReference</code></td>
                                        <td>@entry.Amount</td>
                                        <td>@entry.CreditDebit</td>
                                        <td>@entry.BookingDate</td>
                                    </tr>
                                }
                            </tbody>
                        </table>
                    </div>
                }

                @if (_camt086Services is { Count: > 0 })
                {
                    <h6 class="mt-3">Services (first statement)</h6>
                    <div class="table-responsive">
                        <table class="table table-sm">
                            <thead>
                                <tr><th scope="col">Service ID</th><th scope="col">Description</th><th scope="col">Original charge price</th></tr>
                            </thead>
                            <tbody>
                                @foreach (var service in _camt086Services)
                                {
                                    <tr>
                                        <td><code>@service.ServiceId</code></td>
                                        <td>@service.Description</td>
                                        <td>@service.OriginalChargePrice</td>
                                    </tr>
                                }
                            </tbody>
                        </table>
                    </div>
                }

                @if (_pain002Transactions is { Count: > 0 })
                {
                    <h6 class="mt-3">Transaction statuses</h6>
                    <div class="table-responsive">
                        <table class="table table-sm">
                            <thead>
                                <tr><th scope="col">Original End-to-End ID</th><th scope="col">Status</th><th scope="col">Amount</th></tr>
                            </thead>
                            <tbody>
                                @foreach (var tx in _pain002Transactions)
                                {
                                    <tr>
                                        <td><code>@tx.OriginalEndToEndId</code></td>
                                        <td>@tx.Status</td>
                                        <td>@tx.Amount</td>
                                    </tr>
                                }
                            </tbody>
                        </table>
                    </div>
                }
            }
        </div>
    </div>
</div>

@code {
    private string _xml = "";
    private string? _error;
    private Iso20022MessageIdentifier? _identifier;
    private List<(string Label, string Value)>? _summaryRows;
    private List<(string EntryReference, string Amount, string CreditDebit, string BookingDate)>? _camtEntries;
    private List<(string ServiceId, string Description, string OriginalChargePrice)>? _camt086Services;
    private List<(string OriginalEndToEndId, string Status, string Amount)>? _pain002Transactions;

    private void Parse()
    {
        Clear();

        try
        {
            var document = Iso20022Document.Load(_xml);
            var identifier = Iso20022Document.Identify(document);
            _identifier = identifier;

            switch (identifier.Type)
            {
                case Iso20022MessageType.Camt052 or Iso20022MessageType.Camt053 or Iso20022MessageType.Camt054:
                    ParseCamt(document);
                    break;
                case Iso20022MessageType.Camt086:
                    ParseCamt086(document);
                    break;
                case Iso20022MessageType.Pain002:
                    ParsePain002(document);
                    break;
                default:
                    _summaryRows = [("Note", "This document type is not covered by CamtReader, Camt086Reader, or Pain002Reader, but was still recognized structurally by Iso20022Document.")];
                    break;
            }
        }
        catch (Iso20022ValidationException ex)
        {
            _error = ex.Path is null ? ex.Message : $"{ex.Message} (Path: {ex.Path})";
        }
        catch (Exception ex) when (ex is System.Xml.XmlException or ArgumentException or InvalidOperationException)
        {
            _error = ex.Message;
        }
    }

    private void ParseCamt(XDocument document)
    {
        var message = CamtReader.Read(document);
        _summaryRows =
        [
            ("Message ID", message.GroupHeader.MessageId ?? "—"),
            ("Created", message.GroupHeader.CreationDateTime?.ToString("u", CultureInfo.InvariantCulture) ?? "—"),
            ("Statements", message.Statements.Count.ToString(CultureInfo.InvariantCulture))
        ];

        var first = message.Statements.FirstOrDefault();
        if (first is null) return;

        _summaryRows.Add(("Account", first.Account?.Iban ?? first.Account?.OtherId ?? "—"));
        _summaryRows.Add(("Balances", first.Balances.Count.ToString(CultureInfo.InvariantCulture)));

        _camtEntries = first.Entries.Select(entry => (
            entry.EntryReference ?? "—",
            FormatMoney(entry.Amount),
            entry.CreditDebit.ToString(),
            entry.BookingDate?.ToString("yyyy-MM-dd", CultureInfo.InvariantCulture)
                ?? entry.BookingDateTime?.ToString("yyyy-MM-dd", CultureInfo.InvariantCulture)
                ?? "—"
        )).ToList();
    }

    private void ParseCamt086(XDocument document)
    {
        var message = Camt086Reader.Read(document);
        var statement = message.Groups.SelectMany(g => g.Statements).FirstOrDefault();

        _summaryRows =
        [
            ("Report ID", message.ReportId ?? "—"),
            ("Groups", message.Groups.Count.ToString(CultureInfo.InvariantCulture)),
            ("Statements", message.Groups.Sum(g => g.Statements.Count).ToString(CultureInfo.InvariantCulture))
        ];

        if (statement is null) return;

        _summaryRows.Add(("Statement ID", statement.StatementId ?? "—"));
        _camt086Services = statement.Services.Select(service => (
            service.ServiceId ?? "—",
            service.Description ?? "—",
            service.OriginalChargePrice is { } price ? FormatMoney(price) : "—"
        )).ToList();
    }

    private void ParsePain002(XDocument document)
    {
        var report = Pain002Reader.Read(document);
        _summaryRows =
        [
            ("Message ID", report.MessageId ?? "—"),
            ("Original message ID", report.OriginalGroup.OriginalMessageId ?? "—"),
            ("Group status", report.OriginalGroup.GroupStatus ?? "—"),
            ("Payment informations", report.PaymentInformations.Count.ToString(CultureInfo.InvariantCulture))
        ];

        _pain002Transactions = report.PaymentInformations
            .SelectMany(p => p.Transactions)
            .Select(tx => (
                tx.OriginalEndToEndId ?? "—",
                tx.Status ?? "—",
                tx.OriginalTransaction?.Amount is { } amount ? FormatMoney(amount) : "—"
            ))
            .ToList();
    }

    private static string FormatMoney(Money money) =>
        $"{money.Amount.ToString("0.00", CultureInfo.InvariantCulture)} {money.Currency}";

    private void Clear()
    {
        _error = null;
        _identifier = null;
        _summaryRows = null;
        _camtEntries = null;
        _camt086Services = null;
        _pain002Transactions = null;
    }
}
