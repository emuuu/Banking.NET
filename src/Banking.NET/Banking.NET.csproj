<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <TargetFrameworks>$(LibraryTargetFrameworks)</TargetFrameworks>
    <PackageId>Banking.NET</PackageId>
    <RootNamespace>Banking.NET</RootNamespace>
    <AssemblyName>Banking.NET</AssemblyName>
    <PackageReadmeFile>README.md</PackageReadmeFile>
    <UseRepoReadmeInPackage>false</UseRepoReadmeInPackage>
  </PropertyGroup>

  <ItemGroup>
    <None Include="NUGET_README.md" Pack="true" PackagePath="README.md" Condition="Exists('NUGET_README.md')" />
  </ItemGroup>

  <ItemGroup>
    <PackageReference Include="Microsoft.Extensions.DependencyInjection" />
    <PackageReference Include="Microsoft.Extensions.Http" />
    <PackageReference Include="Microsoft.Extensions.Options.ConfigurationExtensions" />
  </ItemGroup>

  <ItemGroup>
    <InternalsVisibleTo Include="Banking.NET.Tests" />
  </ItemGroup>

</Project>
